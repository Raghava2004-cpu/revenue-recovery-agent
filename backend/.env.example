# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value here is OPTIONAL: with an empty .env the
# agent still runs the full pipeline, the batch demo, and the dashboard.
# ---------------------------------------------------------------------------

# Razorpay test-mode credentials.
# dashboard.razorpay.com -> Settings -> API Keys -> Generate Test Key
# Needed only for the LIVE webhook path. The batch demo never calls Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# dashboard.razorpay.com -> Settings -> Webhooks -> your webhook's secret.
# Webhooks are rejected outright if this is unset — an unverified webhook is an
# unauthenticated write into your revenue ledger.
RAZORPAY_WEBHOOK_SECRET=

# Anthropic API key. Enables two things:
#   1. LLM diagnosis for failures whose error reason is free text the rule
#      engine can't match (~14% of cases). Without it those go to a human.
#   2. Per-customer Hinglish message generation. Without it the deterministic
#      templates are used, which are complete and shippable, just less tailored.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

DATABASE_URL=sqlite:///./revenue_recovery.db
